{
  "productName": "dida",
  "version": "1.0.1",
  "identifier": "com.subinlee.ondiary",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "dida",
        "width": 1800,
        "height": 1012,
        "minWidth": 900,
        "minHeight": 506,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": { "allow": ["**"] }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  },
  "plugins": {
    "sql": {
      "preloadConnections": []
    },
    "updater": {
      "endpoints": [
        "https://github.com/RamzThunder/on-diary/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDQzIxOUIwRUQ1OEMwOTMKUldTVHdGanRzQm5DdkpjYVBKbDBRK2JlMHhndjgza1NhV1BUSjVWQnJuZ0lpRkp4K29TZzhEejgK"
    }
  }
}
